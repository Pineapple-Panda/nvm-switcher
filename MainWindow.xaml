<Window x:Class="Nvm03.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NVM-03" Height="650" Width="620" MinHeight="500" MinWidth="500"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="1" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="32,28,32,20">
      <StackPanel>
        <TextBlock Text="NVM-03" FontFamily="Segoe UI" FontWeight="Light" FontSize="32" Foreground="{StaticResource InkBrush}" />
        <TextBlock Text="NODE VERSION CONTROL / LOCAL MACHINE" Margin="1,2,0,0" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource ActionBrush}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Background="{StaticResource Ink80Brush}" />

    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="32,22,32,28">
      <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <TextBlock Text="INSTALL NODE.JS" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
        <TextBlock HorizontalAlignment="Right" Text="ADMINISTRATOR MODE" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource SuccessBrush}" />
      </Grid>

      <Grid Grid.Row="1" Margin="0,8,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="54" /><ColumnDefinition Width="8" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Height="54" Background="{StaticResource InkBrush}">
          <TextBox x:Name="VersionInput" Style="{StaticResource NorthInput}" Background="Transparent" ToolTip="Node.js version, e.g. 20.18.0" KeyDown="VersionInput_KeyDown" />
          <TextBlock x:Name="LatestVersionHint" Margin="14,0,14,7" VerticalAlignment="Bottom" IsHitTestVisible="False" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource MutedBrush}" Text="CHECKING LATEST NODE.JS VERSION..." />
        </Grid>
        <Button x:Name="InstallButton" Grid.Column="2" Style="{StaticResource NorthPrimaryButton}" ToolTip="Install version" Click="InstallButton_Click">
          <Canvas Width="19" Height="19">
            <Path Data="M 2,2 L 14,2 L 17,5 L 17,17 L 2,17 Z M 5,2 L 5,8 L 14,8 L 14,2 M 5,17 L 5,11 L 14,11 L 14,17" Fill="{x:Null}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineJoin="Round" />
          </Canvas>
        </Button>
        <Button x:Name="RefreshButton" Grid.Column="4" Style="{StaticResource NorthButton}" Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}" ToolTip="Refresh installed versions" Click="RefreshButton_Click">
          <Canvas Width="19" Height="19">
            <Path Data="M 16,7 A 7,7 0 1 0 16,12 M 16,2 L 16,7 L 11,7" Fill="{x:Null}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          </Canvas>
        </Button>
      </Grid>

      <Grid Grid.Row="2" Margin="0,6,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,8">
          <TextBlock Text="INSTALLED VERSIONS" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
          <TextBlock HorizontalAlignment="Right" Text="SELECT TO ACTIVATE" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource Ink80Brush}" />
        </Grid>
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="0">
          <Grid>
          <ListBox x:Name="VersionsList" Style="{StaticResource NorthListBox}" AlternationCount="100" SelectionChanged="VersionsList_SelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Height="53">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), StringFormat={}{0:D2}}" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                  <TextBlock Grid.Column="1" Text="{Binding Version}" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="17" Foreground="{StaticResource InkBrush}" />
                  <ItemsControl Grid.Column="2" VerticalAlignment="Center" ItemsSource="{Binding Tags}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource Ink80Brush}" Margin="0,0,4,0" Padding="5,3"><TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource CanvasBrush}" /></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                  <Border Grid.Column="3" Background="{StaticResource SuccessBrush}" Padding="7,4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsActive, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="ACTIVE" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource CanvasBrush}" /></Border>
                  <Button Grid.Column="4" Style="{StaticResource TagButton}" ToolTip="Edit tags" PreviewMouseLeftButtonDown="EditTagsButton_PreviewMouseLeftButtonDown"><TextBlock Text="+" FontFamily="Consolas" FontSize="19" /></Button>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
           <TextBlock x:Name="EmptyState" Text="NO INSTALLED NODE.JS VERSIONS" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed" />
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Row="3" Margin="0" Padding="12,9" Background="{StaticResource InkBrush}" CornerRadius="0,0,5,5">
        <TextBlock x:Name="StatusText" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource CanvasBrush}" TextWrapping="Wrap" />
      </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
